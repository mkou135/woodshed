{
  "name": "woodshed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Turn a transcribed jazz solo into practice material",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "solo": "node --experimental-strip-types --no-warnings scripts/run.ts",
    "eval:wjd": "node --experimental-strip-types --no-warnings scripts/eval-wjd.ts",
    "corpus:freq": "node --experimental-strip-types --no-warnings scripts/corpus-freq.ts",
    "corpus:wjd": "node --experimental-strip-types --no-warnings scripts/corpus-wjd.ts",
    "diag:wjd": "node --experimental-strip-types scripts/diag-wjd.ts",
    "brackets": "node --experimental-strip-types --no-warnings scripts/brackets.ts",
    "bench:bopland": "node --experimental-strip-types --no-warnings scripts/bench-bopland.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.2",
    "opensheetmusicdisplay": "^2.1.2",
    "vite": "^5.4.21",
    "zod": "^4.4.3"
  }
}
